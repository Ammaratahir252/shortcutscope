   "source": "import os; os.chdir('/kaggle/working'); os.environ['HF_DATASETS_CACHE']='/tmp/hf_datasets'\nimport datasets, librosa, sklearn; print(datasets.__version__, librosa.__version__, sklearn.__version__)\n!df -h /tmp /kaggle/working | tail -2"
